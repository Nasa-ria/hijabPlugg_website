APP_NAME="Nasaari Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@nasaari.store"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nasaari social media and contact details (leave empty to hide)
SOCIAL_HANDLE=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
SOCIAL_FACEBOOK=
SOCIAL_WHATSAPP=
SOCIAL_X=
SOCIAL_SNAPCHAT=
SOCIAL_PINTEREST=
SOCIAL_YOUTUBE=
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_HOURS="Monday – Saturday, 9:00 am – 6:00 pm"

# "New order" notification email(s), comma separated
ADMIN_ORDER_EMAILS="orders@nasaari.store"

# Paystack (dashboard.paystack.com -> Settings -> API Keys & Webhooks)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYMENT_CURRENCY=GHS

# Checkout & inventory (all stored amounts are Ghana Cedis)
SHOP_TAX_RATE=0.05
INVENTORY_LOW_STOCK_THRESHOLD=5
# Unpaid orders hold stock this long, then are cancelled (php artisan schedule:run must run every minute)
INVENTORY_RELEASE_UNPAID_AFTER_HOURS=48

# Display currency: Ghana sees GH₵, other countries see US$. Display only - Paystack always charges GHS.
EXCHANGE_RATE_URL=https://open.er-api.com/v6/latest/GHS
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_CACHE_MINUTES=720
# USD per 1 GHS, used only if the rate source is down and nothing is cached (e.g. 0.065)
EXCHANGE_RATE_FALLBACK_GHS_USD=
# Country lookup by IP when your host/CDN sends no country header. Leave empty to turn off.
GEOIP_LOOKUP_URL=https://ipapi.co/{ip}/country/

# Shipping: Ghana pays on delivery; other countries get live DHL Express rates
SHIPPING_DOMESTIC_COUNTRY=GH
SHIPPING_ORIGIN_COUNTRY=GH
SHIPPING_ORIGIN_CITY=Accra
SHIPPING_ORIGIN_POSTAL_CODE=
SHIPPING_ORIGIN_ADDRESS=
# Defaults for products without their own weight/size (one folded unit)
SHIPPING_DEFAULT_ITEM_WEIGHT_KG=0.3
SHIPPING_DEFAULT_ITEM_LENGTH_CM=30
SHIPPING_DEFAULT_ITEM_WIDTH_CM=25
SHIPPING_DEFAULT_ITEM_HEIGHT_CM=3
SHIPPING_PACKAGING_WEIGHT_KG=0.2

# DHL Express MyDHL API (developer.dhl.com). DHL_ENVIRONMENT: test or production
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=
DHL_ENVIRONMENT=test
# Optional: always use one DHL product, e.g. P (Express Worldwide). Empty = cheapest offered
DHL_PRODUCT_CODE=
